<odoo>
    <record id="view_product_category_credit_list" model="ir.ui.view">
        <field name="name">product.category.credit.list</field>
        <field name="model">product.category.credit</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id" />
                <field name="name" />
                <field name="category_id" />
                <field name="credit" />
                <field name="used_credit" />
                <field name="available_credit" />
            </list>
        </field>
    </record>

    <record id="action_product_category_credit" model="ir.actions.act_window">
        <field name="name">Credit Lines</field>
        <field name="res_model">product.category.credit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_product_category_credit"
        name="Credit Lines"
        parent="account.account_reports_legal_statements_menu"
        action="action_product_category_credit"
    />
</odoo>
