<odoo>
  <record id="view_partner_form_credit" model="ir.ui.view">
    <field name="name">res.partner.form.credit</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='accounting']" position="inside">
        <group string="Límites de Crédito">
          <field name="supplier_credit_id" domain="[('type','=','supplier')]" context="{'default_type':'supplier'}"/>
          <field name="product_category_credit_ids" context="{'default_type':'customer'}"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
