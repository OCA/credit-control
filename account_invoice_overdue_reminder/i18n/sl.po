#. module: account_invoice_overdue_reminder
#: model:mail.template,body_html:account_invoice_overdue_reminder.overdue_invoice_reminder_mail_template
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p>Dear customer,</p>\n"
"                <p>According to our books, the following invoices are overdue:</p>\n"
"\n"
"                <table style=\"border-spacing: 0; border-collapse: collapse; width: 100%; text-align: center;\">\n"
"                    <tr>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">Invoice Number</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">Invoice Date</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">Payment Terms</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">Due Date</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">Order Ref.</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">Type</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">Total Untaxed</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">Total</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">Residual</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">Past Reminders</th>\n"
"                    </tr>\n"
"                    <t t-foreach=\"object.invoice_ids.sorted(key='invoice_date')\" t-as=\"inv\">\n"
"                        <tr style=\"background-color:                             % if inv.move_type == 'out_refund':                                 LightGray                             % endif                         \">\n"
"                            <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                                <t t-out=\"inv.name\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                                <t t-out=\"format_date(inv.invoice_date)\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                                <t t-out=\"inv.invoice_payment_term_id.name or ''\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                                <t t-out=\"format_date(inv.invoice_date_due)\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                                <t t-out=\"inv.ref or ''\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                                <t t-out=\"dict(inv.fields_get(allfields=['move_type'])['move_type']['selection'])[inv.move_type]\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid black; text-align: right;\">\n"
"                                <t t-out=\"format_amount(inv.amount_untaxed * (inv.move_type == 'out_refund' and -1 or 1), inv.currency_id)\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid black; text-align: right;\">\n"
"                                <t t-out=\"format_amount(inv.amount_total * (inv.move_type == 'out_refund' and -1 or 1), inv.currency_id)\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid black; text-align: right;\">\n"
"                                <t t-out=\"format_amount(inv.amount_residual * (inv.move_type == 'out_refund' and -1 or 1), inv.currency_id)\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid black;\">\n"
"                                <t t-out=\"inv.overdue_reminder_counter\"/>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </t>\n"
"                    <t t-foreach=\"object.total_residual()\" t-as=\"total_residual\">\n"
"                        <tr>\n"
"                            <td/>\n"
"                            <td/>\n"
"                            <td/>\n"
"                            <td/>\n"
"                            <td/>\n"
"                            <td/>\n"
"                            <td colspan=\"2\" style=\"padding: 5px; border: 1px solid black; font-weight: bold; text-align: right;\">\n"
"                                Total\n"
"                                Residual in\n"
"                                <t t-out=\"total_residual[0].name\"/>:\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid black; font-weight: bold; text-align: right;\">\n"
"                                <t t-out=\"format_amount(total_residual[1], total_residual[0])\"/>\n"
"                            </td>\n"
"                            <td/>\n"
"                        </tr>\n"
"                    </t>\n"
"                </table>\n"
"\n"
"                <p>If you made a payment for these invoices a few days ago, please ignore this email.</p>\n"
"\n"
"                <t t-if=\"object.company_id.overdue_reminder_attach_invoice\">\n"
"                    <p>You will find enclosed the overdue invoices.</p>\n"
"                </t>\n"
"\n"
"                <t t-if=\"object.counter &gt; 2\">\n"
"                    <p>Despite several reminders, we are disappointed to see that these overdue invoices are still\n"
"                        unpaid.\n"
"                        In order to avoid legal proceedings, we urge you to paid these overdue invoices in the next\n"
"                        days.\n"
"                    </p>\n"
"                </t>\n"
"\n"
"                <p>Regards,</p>\n"
"\n"
"                <t t-if=\"user.signature\">\n"
"                    <p>\n"
"                        <t t-out=\"user.signature or ''\"/>\n"
"                    </p>\n"
"                </t>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p>Spoštovani kupec,</p>\n"
"                <p>Po naših evidencah so naslednji računi zapadli:</p>\n"
"\n"
"                <table style=\"border-spacing: 0; border-collapse: collapse; "
"width: 100%; text-align: center;\">\n"
"                    <tr>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">"
"Številka računa</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">"
"Datum računa</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">"
"Plačilni pogoji</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">"
"Datum zapadlosti</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">"
"Sklic naročila</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">"
"Tip</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">"
"Skupaj brez davka</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">"
"Skupaj</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">"
"Preostalo</th>\n"
"                        <th style=\"padding: 5px; border: 1px solid black;\">"
"Pretekli opomini</th>\n"
"                    </tr>\n"
"                    <t t-foreach=\"object.invoice_ids.sorted"
"(key='invoice_date')\" t-as=\"inv\">\n"
"                        <tr style=\"background-"
"color:                             % if inv.move_type == "
"'out_refund':                                 LightGray"
"                             % endif                         \">\n"
"                            <td style=\"padding: 5px; border: 1px solid "
"black;\">\n"
"                                <t t-out=\"inv.name\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid "
"black;\">\n"
"                                <t t-out=\"format_date(inv.invoice_date)\"/>"
"\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid "
"black;\">\n"
"                                <t t-out=\"inv.invoice_payment_term_id.name "
"or ''\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid "
"black;\">\n"
"                                <t t-out=\"format_date(inv.invoice_date_due)"
"\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid "
"black;\">\n"
"                                <t t-out=\"inv.ref or ''\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid "
"black;\">\n"
"                                <t t-out=\"dict(inv.fields_get"
"(allfields=['move_type'])['move_type']['selection'])[inv.move_type]\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid "
"black; text-align: right;\">\n"
"                                <t t-out=\"format_amount(inv.amount_untaxed "
"* (inv.move_type == 'out_refund' and -1 or 1), inv.currency_id)\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid "
"black; text-align: right;\">\n"
"                                <t t-out=\"format_amount(inv.amount_total * "
"(inv.move_type == 'out_refund' and -1 or 1), inv.currency_id)\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid "
"black; text-align: right;\">\n"
"                                <t t-out=\"format_amount(inv.amount_residual "
"* (inv.move_type == 'out_refund' and -1 or 1), inv.currency_id)\"/>\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid "
"black;\">\n"
"                                <t t-out=\"inv.overdue_reminder_counter\"/>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </t>\n"
"                    <t t-foreach=\"object.total_residual()\" t-"
"as=\"total_residual\">\n"
"                        <tr>\n"
"                            <td/>\n"
"                            <td/>\n"
"                            <td/>\n"
"                            <td/>\n"
"                            <td/>\n"
"                            <td/>\n"
"                            <td colspan=\"2\" style=\"padding: 5px; border: "
"1px solid black; font-weight: bold; text-align: right;\">\n"
"                                Skupaj\n"
"                                preostalo v\n"
"                                <t t-out=\"total_residual[0].name\"/>:\n"
"                            </td>\n"
"                            <td style=\"padding: 5px; border: 1px solid "
"black; font-weight: bold; text-align: right;\">\n"
"                                <t t-out=\"format_amount(total_residual[1], "
"total_residual[0])\"/>\n"
"                            </td>\n"
"                            <td/>\n"
"                        </tr>\n"
"                    </t>\n"
"                </table>\n"
"\n"
"                <p>Če ste te račune plačali pred nekaj dnevi, prosimo, "
"prezrite to e-pošto.</p>\n"
"\n"
"                <t t-"
"if=\"object.company_id.overdue_reminder_attach_invoice\">\n"
"                    <p>V prilogi so zapadli računi.</p>\n"
"                </t>\n"
"\n"
"                <t t-if=\"object.counter &gt; 2\">\n"
"                    <p>Kljub več opominom ugotavljamo, da ti zapadli računi "
"še vedno niso\n"
"                        plačani.\n"
"                        Da se izognemo pravnim postopkom, vas pozivamo, da "
"te zapadle račune plačate v naslednjih\n"
"                        dneh.\n"
"                    </p>\n"
"                </t>\n"
"\n"
"                <p>Lep pozdrav,</p>\n"
"\n"
"                <t t-if=\"user.signature\">\n"
"                    <p>\n"
"                        <t t-out=\"user.signature or ''\"/>\n"
"                    </p>\n"
"                </t>\n"
"            </div>\n"
"        "

