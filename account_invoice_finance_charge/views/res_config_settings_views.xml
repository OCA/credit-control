<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.finance.charge</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Finance Charges" name="finance_charge_container">
                    <setting
                        id="finance_charge_setting"
                        string="Charges on past-due invoices"
                        help="Used by Customers &gt; Finance Charges. Charges are always created as drafts."
                    >
                        <div class="content-group">
                            <div class="row mt8">
                                <label
                                    for="finance_charge_rate"
                                    class="col-lg-6 o_light_label"
                                    string="Annual rate (%)"
                                />
                                <field name="finance_charge_rate" />
                            </div>
                            <div class="row">
                                <label
                                    for="finance_charge_grace_days"
                                    class="col-lg-6 o_light_label"
                                    string="Grace days"
                                />
                                <field name="finance_charge_grace_days" />
                            </div>
                            <div class="row">
                                <label
                                    for="finance_charge_interval_days"
                                    class="col-lg-6 o_light_label"
                                    string="Days between charges"
                                />
                                <field name="finance_charge_interval_days" />
                            </div>
                            <div class="row">
                                <label
                                    for="finance_charge_min_amount"
                                    class="col-lg-6 o_light_label"
                                    string="Minimum charge"
                                />
                                <field name="finance_charge_min_amount" />
                            </div>
                            <div class="row">
                                <label
                                    for="finance_charge_cap_percent"
                                    class="col-lg-6 o_light_label"
                                    string="Cap per invoice (%)"
                                />
                                <field name="finance_charge_cap_percent" />
                            </div>
                            <div class="row">
                                <label
                                    for="finance_charge_account_id"
                                    class="col-lg-6 o_light_label"
                                    string="Income account"
                                />
                                <field
                                    name="finance_charge_account_id"
                                    domain="[('account_type', 'in', ('income', 'income_other'))]"
                                    options="{'no_create': True}"
                                />
                            </div>
                            <div class="row">
                                <label
                                    for="finance_charge_journal_id"
                                    class="col-lg-6 o_light_label"
                                    string="Journal"
                                />
                                <field
                                    name="finance_charge_journal_id"
                                    domain="[('type', '=', 'sale')]"
                                    options="{'no_create': True}"
                                />
                            </div>
                            <div class="row">
                                <label
                                    for="finance_charge_product_id"
                                    class="col-lg-6 o_light_label"
                                    string="Product (optional)"
                                />
                                <field
                                    name="finance_charge_product_id"
                                    options="{'no_create': True}"
                                />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
