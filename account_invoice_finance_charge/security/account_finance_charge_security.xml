<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="account_finance_charge_line_company_rule" model="ir.rule">
        <field name="name">Finance charge periods: multi-company</field>
        <field name="model_id" ref="model_account_finance_charge_line" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="account_finance_charge_wizard_owner_rule" model="ir.rule">
        <field name="name">Finance charge review: own screens only</field>
        <field name="model_id" ref="model_account_finance_charge_wizard" />
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="account_finance_charge_wizard_line_owner_rule" model="ir.rule">
        <field name="name">Finance charge review lines: own screens only</field>
        <field name="model_id" ref="model_account_finance_charge_wizard_line" />
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
</odoo>
