<odoo>
    <record id="credit_control_policy_form" model="ir.ui.view">
        <field name="name">credit.control.policy.form.all.receivable</field>
        <field name="model">credit.control.policy</field>
        <field
            name="inherit_id"
            ref="account_credit_control.credit_control_policy_form"
        />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="all_receivable_accounts" />
            </field>
            <xpath expr="//field[@name='account_ids']/.." position="attributes">
                <attribute name="attrs">
                    {'invisible': [('all_receivable_accounts', '=', True)]}
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
