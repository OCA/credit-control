<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Hide the core warning because it does not reflect the partner risk rules. -->
    <record id="sale_order_view_hide_partner_credit_warning" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@role='alert' and field[@name='partner_credit_warning']]"
                position="attributes"
            >
                <attribute name="invisible">True</attribute>
            </xpath>
        </field>
    </record>

    <record id="financial_risk_sale_order_line_pivot_view" model="ir.ui.view">
        <field name="name">Account financial risk sale pivot view</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Sale lines">
                <field name="order_partner_id" type="row" />
                <field name="risk_amount" type="measure" />
                <field name="product_uom_qty" type="measure" />
                <field name="qty_delivered" type="measure" />
                <field name="qty_invoiced" type="measure" />
            </pivot>
        </field>
    </record>
</odoo>
